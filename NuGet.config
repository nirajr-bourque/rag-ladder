<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pinned to nuget.org only. Machine-level private feeds (which may require auth)
       would otherwise break restore for anyone cloning this repo. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
