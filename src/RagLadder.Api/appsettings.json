{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5099" }
    }
  },

  "RagLadder": {
    "Providers": {
      "Vector": "memory",
      "Graph": "memory",
      "Chat": "ollama",
      "Embedder": "onnx",
      "Reranker": "onnx",
      "FallbackToLocal": true
    },

    "Storage": {
      "DataDirectory": "data",
      "SqliteFile": "ragladder.db",
      "CorpusDirectory": "corpus",
      "RecordingsDirectory": "recordings",
      "//DemoPdf": "Which PDF the Load-demo button attaches. The Spider-Man seed is a subset chosen so a full pass finishes in minutes on CPU; use serendib-dossier.pdf for the whole dossier.",
      "DemoPdf": "spiderman-seed.pdf"
    },

    "Embedding": {
      "ModelId": "all-MiniLM-L6-v2",
      "ModelPath": "models/all-MiniLM-L6-v2/model.onnx",
      "VocabPath": "models/all-MiniLM-L6-v2/vocab.txt",
      "OllamaModel": "nomic-embed-text",
      "Dimensions": 384,
      "MaxTokens": 256,
      "BatchSize": 32
    },

    "Rerank": {
      "ModelId": "ms-marco-MiniLM-L-6-v2",
      "ModelPath": "models/ms-marco-MiniLM-L-6-v2/model.onnx",
      "VocabPath": "models/ms-marco-MiniLM-L-6-v2/vocab.txt",
      "MaxTokens": 320
    },

    "Ollama": {
      "BaseUrl": "https://ollama.com",
      "ApiKey": "",
      "ChatModel": "gpt-oss:120b-cloud",
      "ExtractionModel": "gpt-oss:120b-cloud",
      "TimeoutSeconds": 600,
      "MaxRetries": 3,
      "//MaxConcurrency": "1 keeps the shared extraction prompt prefix in the KV cache, which cuts prefill from ~131s to ~3s on a local model. Raise to 2 for a hosted provider.",
      "MaxConcurrency": 1,
      "ValidateTagsAtStartup": true,
      "NumCtx": 8192
    },

    "//OpenAiCompatible": "Set Providers:Chat to 'openai' to use any endpoint speaking the OpenAI chat-completions shape — an internal gateway, LiteLLM, vLLM, LM Studio, llama.cpp. Use this when neither Ollama route is available. ChatPath supports a {model} placeholder for gateways that put the model in the path; AuthHeader and AuthScheme cover non-Bearer schemes.",
    "OpenAiCompatible": {
      "BaseUrl": "",
      "ApiKey": "",
      "ChatModel": "gpt-4o-mini",
      "ExtractionModel": "gpt-4o-mini",
      "ChatPath": "chat/completions",
      "AuthHeader": "Authorization",
      "AuthScheme": "Bearer",
      "SupportsJsonMode": true,
      "SendTemperature": true,
      "TimeoutSeconds": 180,
      "MaxRetries": 3,
      "MaxConcurrency": 2
    },

    "Qdrant": {
      "Url": "",
      "ApiKey": "",
      "TimeoutSeconds": 60
    },

    "Neo4j": {
      "Uri": "",
      "User": "neo4j",
      "Password": "",
      "Database": "neo4j"
    },

    "Chunking": {
      "FixedTokens": 400,
      "RecursiveTokens": 400,
      "RecursiveOverlapTokens": 80,
      "CommitBatchSize": 500
    },

    "Extraction": {
      "DefaultMode": "thorough",
      "ChunkCap": 120,
      "VerificationBatchSize": 10,
      "ConfidenceFloor": 0.6,
      "PartialConfidenceMultiplier": 0.7,
      "SourceStrategy": "recursive",
      "PreviousChunkTailChars": 200,
      "OntologyVersion": "film-v3"
    },

    "Retrieval": {
      "TopK": 5,
      "CandidateK": 50,
      "RrfK": 60,
      "MinEdgeConfidence": 0.6,
      "MaxPathHops": 6,
      "RefusalText": "Not found in the provided documents."
    },

    "Agentic": {
      "MaxIterations": 4,
      "MaxChatCalls": 6
    },

    "Domain": {
      "OntologyPath": "config/film-ontology.json",
      "DiminutivesPath": "config/name-diminutives.json",
      "StudioSuffixes": [ "Pictures", "Studios", "Entertainment", "Films", "Productions", "Inc", "Ltd" ],
      "TitleArticles": [ "The", "A", "An" ],
      "EntityMergeCosine": 0.92,
      "EntityMergeJaroWinkler": 0.88,
      "MaxPathHops": 12,
      "BlockCrossTypeMerge": true
    },

    "Replay": {
      "Enabled": false,
      "Record": false
    }
  }
}
