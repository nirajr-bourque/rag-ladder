<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets `dotnet user-secrets` hold the three API keys outside the repository. -->
    <UserSecretsId>ragladder-film-demo</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.11" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <PackageReference Include="Neo4j.Driver" Version="6.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

  <!-- Copied to the build output so the app serves its UI whether it is started via
       "dotnet run", from the bin directory, or from a published folder. -->
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
